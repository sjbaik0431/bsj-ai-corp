# 로컬 .env.local 파일로 복사 후 값 채우기 (절대 git에 커밋되지 않음)

# Anthropic (필수 — 5인 에이전트)
ANTHROPIC_API_KEY=sk-ant-...

# OpenAI (Phase C 음성 시 — TTS-1 / Whisper)
OPENAI_API_KEY=sk-...

# Apify (Phase B MICE/산단/뉴스 자동 수집)
APIFY_TOKEN=...

# Google (Phase B Gmail/Calendar) — OAuth 토큰 발급 후
GOOGLE_CLIENT_ID=...
GOOGLE_CLIENT_SECRET=...
GOOGLE_REFRESH_TOKEN=...

# 로컬 서버 포트 (기본 3000)
PORT=3000
